-- 1. Non-correlated subquery
-- Find regions having more sales than the average number of sales per region

SELECT
    region,
    COUNT(*) AS total_sales
FROM sales
GROUP BY region
HAVING COUNT(*) &gt; (
    SELECT AVG(region_sales)
    FROM (
        SELECT COUNT(*) AS region_sales
        FROM sales
        GROUP BY region
    )
);


-- 2. Correlated subquery
-- Find the top performer per region

SELECT
    s1.region,
    s1.customer_name,
    s1.customer_id
FROM sales AS s1
WHERE (
    SELECT COUNT(*)
    FROM sales AS s2
    WHERE s2.region = s1.region
      AND s2.customer_id = s1.customer_id
);(
    SELECT COUNT(*)
    FROM sales AS s3
    WHERE s3.region = s1.region
    GROUP BY s3.customer_id
);


-- 3. Rewrite a nested subquery as a CTE
-- Find regions with more than 3 sales

WITH region_sales AS (
    SELECT
        region,
        COUNT(*) AS total_sales
    FROM sales
    GROUP BY region
)
SELECT
    region,
    total_sales
FROM region_sales
WHERE total_sales &gt; 3;


-- 4. Chain 2 CTEs in a single query
-- Find customers whose sales count is above the average customer sales

WITH customer_sales AS (
    SELECT
        customer_id,
        customer_name,
        COUNT(*) AS total_sales
    FROM sales
    GROUP BY customer_id, customer_name
),
average_sales AS (
    SELECT
        AVG(total_sales) AS avg_sales
    FROM customer_sales
)
SELECT
    customer_id,
    customer_name,
    total_sales
FROM customer_sales
WHERE total_sales &gt; (
    SELECT avg_sales
    FROM average_sales
);

</sql><current_tab id="0"/></tab_sql></sqlb_project>
